FROM node:20-alpine

# Install FFmpeg and FFprobe
RUN apk add --no-cache ffmpeg

WORKDIR /app

# Copy package files
COPY package*.json ./
RUN npm ci --only=production

# Copy compiled dist
COPY dist ./dist

# Copy TypeScript config (for source maps if needed)
COPY tsconfig.json ./

# Run the worker (not the main API)
CMD ["node", "dist/worker/main.worker.js"]
